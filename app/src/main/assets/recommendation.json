{
  "openapi": "3.1.0",
  "info": {
    "title": "Recommendation API",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://api.shinyjewelry.shop",
      "description": "API Gateway"
    }
  ],
  "security": [
    {
      "bearer-jwt": []
    }
  ],
  "paths": {
    "/api/v1/recommendations/users/{userId}": {
      "get": {
        "tags": ["recommendation-controller"],
        "operationId": "getRecommendations",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recommendations/learning-path/generate": {
      "post": {
        "tags": [
          "recommendation-controller"
        ],
        "summary": "Generate learning path based on user goals",
        "operationId": "generateLearningPath",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateLearningPathRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseGenerateLearningPathResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer-jwt": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "RecommendationResponse": {
        "type": "object",
        "properties": {}
      },
      "GenerateLearningPathRequest": {
        "type": "object",
        "properties": {
          "goal": {
            "type": "string"
          }
        },
        "required": [
          "goal"
        ]
      },
      "ApiResponseGenerateLearningPathResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/GenerateLearningPathResponse"
          }
        }
      },
      "GenerateLearningPathResponse": {
        "type": "object",
        "properties": {
          "pathName": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GenerateLearningPathItem"
            }
          }
        }
      },
      "GenerateLearningPathItem": {
        "type": "object",
        "properties": {
          "courseId": {
            "type": "string"
          },
          "lessonId": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearer-jwt": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}