<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outermost soft shadow / depth -->
    <item>
        <shape>
            <solid android:color="#0A000000"/>
            <corners android:radius="40dp"/>
        </shape>
    </item>

    <!-- The actual frosted glass body -->
    <item android:bottom="2dp" android:left="1dp" android:right="1dp">
        <shape>
            <!-- White semi-transparent inner background representing blur on a light canvas -->
            <solid android:color="#D9FFFFFF"/>
            
            <!-- Crispy white edge to simulate iOS fluid glass light reflection -->
            <stroke
                android:width="1.5dp"
                android:color="#FFFFFF"/>
            <corners android:radius="40dp"/>
        </shape>
    </item>

    <!-- Subtle inner highlight directly below the top edge -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="8dp">
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#66FFFFFF"
                android:endColor="@android:color/transparent"/>
            <corners android:radius="38dp"/>
        </shape>
    </item>

</layer-list>
