<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The actual frosted glass body -->
    <item>
        <shape>
            <!-- White semi-transparent (85%) -->
            <solid android:color="#D9FFFFFF"/>
        </shape>
    </item>

    <!-- Top border representing the glass reflection (rgba(255, 255, 255, 0.5)) -->
    <item android:bottom="-2dp" android:left="-2dp" android:right="-2dp">
        <shape>
            <stroke
                android:width="1dp"
                android:color="#80FFFFFF"/>
        </shape>
    </item>

</layer-list>
