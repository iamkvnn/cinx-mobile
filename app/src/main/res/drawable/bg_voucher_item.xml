<?xml version="1.0" encoding="utf-8"?>
<!--
  Voucher item background.
  Normal state: white card with subtle shadow rounded rect.
  Selected state (android:state_selected=true): violet border.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Selected / applied -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FAF5FF" />  <!-- violet-50 -->
            <stroke android:width="2dp" android:color="@color/primary" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <!-- Default -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card_background" />
            <stroke android:width="1dp" android:color="@color/divider" />
            <corners android:radius="14dp" />
        </shape>
    </item>

</selector>
