<?xml version="1.0" encoding="utf-8"?>
<!--
  Active tab pill for the PurchaseHistory scrollable tab bar.
  White fill + subtle violet border + inner highlight to simulate
  the elevated look of the HTML .tab-btn.active style.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="100dp" />
    <solid android:color="#FFFFFF" />
    <stroke android:width="1dp" android:color="#DDD6FE" />
</shape>
