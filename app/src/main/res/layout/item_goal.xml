<?xml version="1.0" encoding="utf-8"?>
<!--
  item_goal.xml
  ─────────────
  One row in the daily-goals list.
  · ivGoalIcon – type icon (video / quiz / code) in a tinted pill background
  · tvGoalText – goal description (strikethrough + faded when done)
  · tvGoalTime – scheduled time label
  · ivGoalCheck – tick or empty-circle indicating completion state
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_card_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:layout_marginBottom="8dp">

    <!-- Type icon -->
    <FrameLayout
        android:id="@+id/goalIconBg"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/border_panel"
        android:backgroundTint="#EDE9FE">

        <ImageView
            android:id="@+id/ivGoalIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_zap"
            app:tint="@color/primary" />

    </FrameLayout>

    <!-- Text + time -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp">

        <TextView
            android:id="@+id/tvGoalText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvGoalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Completion check icon -->
    <ImageView
        android:id="@+id/ivGoalCheck"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_circle_outline" />
</LinearLayout>
