<?xml version="1.0" encoding="utf-8"?>
<!--
  A single course row inside an Order card.
  Inflated programmatically by OrderAdapter and added to the
  courses container LinearLayout.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="8dp">

    <!-- Course thumbnail -->
    <ImageView
        android:id="@+id/ivOrderCourseImage"
        android:layout_width="72dp"
        android:layout_height="60dp"
        android:layout_marginEnd="12dp"
        android:scaleType="centerCrop"
        android:contentDescription="@string/order_course_image"
        android:background="@drawable/bg_white_card"
        tools:src="@drawable/bg_glass_card" />

    <!-- Text block -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvOrderCourseTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="UI/UX Design Masterclass: Từ Cơ Bản Đến Nâng Cao" />

        <TextView
            android:id="@+id/tvOrderCourseInstructor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="Bởi Nguyễn Thị Hà Linh" />

        <!-- Price row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvOrderCourseOriginalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textColor="@color/text_placeholder"
                android:textSize="12sp"
                tools:text="1.200.000 đ" />

            <TextView
                android:id="@+id/tvOrderCourseSalePrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="599.000 đ" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
