<?xml version="1.0" encoding="utf-8"?>
<!--
  layout_my_learning_filter.xml
  ──────────────────────────────
  Filter bottom-sheet for MyLearningActivity — inflated inside a BottomSheetDialog.
  Sections:
    ┌──────────────────────────────────────────────────┐
    │  Drag handle                                      │
    │  Header: "Bộ lọc"  +  "Đặt lại"                  │
    │  ─────────────────────────────────────────────── │
    │  Sort chips: Truy cập gần đây · Tiến độ cao …    │
    │  Category chips: Tất cả · Design · Coding · …    │
    │  ─────────────────────────────────────────────── │
    │  [          Áp dụng          ]                   │
    └──────────────────────────────────────────────────┘
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="24dp">

    <!-- Drag handle -->
    <View
        android:id="@+id/dragHandle"
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_drag_handle"
        android:clickable="true"
        android:focusable="true" />

    <!-- Header: title + reset button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bộ lọc"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/btnReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đặt lại"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:layout_marginBottom="20dp" />

    <!-- ── Sort section ─────────────────────────────────────────────────── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SẮP XẾP THEO"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        android:letterSpacing="0.08"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="10dp" />

    <!-- Sort chips row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/chipSortRecent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Truy cập gần đây"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:background="@drawable/bg_filter_chip"
            android:paddingHorizontal="14dp"
            android:paddingVertical="9dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/chipSortHigh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tiến độ cao nhất"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:background="@drawable/bg_filter_chip"
            android:paddingHorizontal="14dp"
            android:paddingVertical="9dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/chipSortLow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tiến độ thấp nhất"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:background="@drawable/bg_filter_chip"
            android:paddingHorizontal="14dp"
            android:paddingVertical="9dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- ── Category section ──────────────────────────────────────────────── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DANH MỤC"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary"
        android:letterSpacing="0.08"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="10dp" />

    <!-- Category chips row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:layout_marginBottom="28dp">

        <TextView
            android:id="@+id/chipCatAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tất cả"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:background="@drawable/bg_filter_chip"
            android:paddingHorizontal="14dp"
            android:paddingVertical="9dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/chipCatDesign"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Design"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:background="@drawable/bg_filter_chip"
            android:paddingHorizontal="14dp"
            android:paddingVertical="9dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/chipCatCoding"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Coding"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:background="@drawable/bg_filter_chip"
            android:paddingHorizontal="14dp"
            android:paddingVertical="9dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/chipCatBusiness"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Business"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:background="@drawable/bg_filter_chip"
            android:paddingHorizontal="14dp"
            android:paddingVertical="9dp"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- ── Apply button ──────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/btnApply"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_btn_primary"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginHorizontal="20dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Áp dụng"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
