<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main_background"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:padding="16dp" android:paddingTop="40dp" android:paddingBottom="40dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:maxWidth="420dp" android:background="@drawable/bg_glass_card" android:orientation="vertical" android:padding="24dp">
            <ImageView android:id="@+id/btn_back" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_chevron_left" app:tint="@color/text_secondary" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackgroundBorderless" android:layout_marginBottom="8dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Xác thực Tải khoản" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/text_primary" android:gravity="center" android:layout_marginBottom="8dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nhập email và mã OTP cùng lúc." android:textSize="14sp" android:textColor="@color/text_secondary" android:gravity="center" android:layout_marginBottom="24dp" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
                <EditText android:id="@+id/input_email" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_glass_input" android:hint="Email của bạn" android:paddingStart="48dp" android:paddingEnd="16dp" android:paddingTop="16dp" android:paddingBottom="16dp" android:inputType="textEmailAddress" android:textColor="@color/text_primary" android:textColorHint="@color/text_placeholder" android:textSize="16sp" android:singleLine="true" />
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center_vertical|start" android:layout_marginStart="16dp" android:src="@drawable/ic_mail" app:tint="@color/text_secondary" />
            </FrameLayout>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_send_otp" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_btn_primary" android:text="Gửi lại mã OTP" android:textColor="@color/white" android:textStyle="bold" android:textSize="14sp" android:padding="12dp" android:layout_marginBottom="24dp" android:textAllCaps="false" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mã OTP" android:textSize="14sp" android:textColor="@color/text_secondary" android:layout_marginBottom="8dp" />
            <LinearLayout android:id="@+id/otp_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:weightSum="6" android:layout_marginBottom="24dp">
                <EditText android:id="@+id/otp_1" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:background="@drawable/bg_otp_input" android:inputType="number" android:maxLength="1" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text_primary" android:gravity="center" android:singleLine="true" />
                <EditText android:id="@+id/otp_2" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:background="@drawable/bg_otp_input" android:inputType="number" android:maxLength="1" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text_primary" android:gravity="center" android:singleLine="true" />
                <EditText android:id="@+id/otp_3" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:background="@drawable/bg_otp_input" android:inputType="number" android:maxLength="1" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text_primary" android:gravity="center" android:singleLine="true" />
                <EditText android:id="@+id/otp_4" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:background="@drawable/bg_otp_input" android:inputType="number" android:maxLength="1" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text_primary" android:gravity="center" android:singleLine="true" />
                <EditText android:id="@+id/otp_5" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:background="@drawable/bg_otp_input" android:inputType="number" android:maxLength="1" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text_primary" android:gravity="center" android:singleLine="true" />
                <EditText android:id="@+id/otp_6" android:layout_width="0dp" android:layout_height="56dp" android:layout_weight="1" android:layout_marginHorizontal="2dp" android:background="@drawable/bg_otp_input" android:inputType="number" android:maxLength="1" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text_primary" android:gravity="center" android:singleLine="true" />
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatButton android:id="@+id/btn_verify_otp" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_btn_primary" android:text="Xác nhận" android:textColor="@color/white" android:textStyle="bold" android:textSize="18sp" android:padding="16dp" android:textAllCaps="false" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>