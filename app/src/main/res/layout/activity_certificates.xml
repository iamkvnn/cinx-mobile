<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    tools:context=".CertificatesActivity">

    <!-- Background blobs -->
    <View
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:background="@drawable/dot_indicator"
        android:backgroundTint="#FDE68A"
        android:alpha="0.40"
        android:scaleX="1.6"
        android:scaleY="1.6"
        android:layout_gravity="top|end"
        android:translationX="80dp"
        android:translationY="-40dp" />

    <View
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:background="@drawable/dot_indicator"
        android:backgroundTint="#DDD6FE"
        android:alpha="0.35"
        android:scaleX="1.4"
        android:scaleY="1.4"
        android:layout_gravity="bottom|start"
        android:translationX="-40dp"
        android:translationY="40dp" />

    <!-- Fixed header -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:background="@drawable/bg_glass_card"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_chevron_left"
            android:background="@drawable/bg_icon_gray"
            android:padding="8dp"
            android:contentDescription="@string/cert_back" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/cert_title"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center" />

        <!-- Spacer to balance back button -->
        <View android:layout_width="40dp" android:layout_height="40dp" />
    </LinearLayout>

    <!-- Scrollable list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCertificates"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="72dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        android:paddingHorizontal="20dp"
        android:clipToPadding="false"
        android:scrollbars="none" />

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="40dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_certificate"
            android:alpha="0.3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/cert_empty"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/cert_empty_desc"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="center" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
