<?xml version="1.0" encoding="utf-8"?>
<!--
  Order card.
  Course rows are injected programmatically by OrderAdapter into
  @id/llOrderCourses, which avoids nested RecyclerViews and keeps
  the layout simple and performant.
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── Header row: order ID & status ─────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <!-- Shopping bag icon + order ID -->
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_bookmark"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvOrderId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="EDUF-8A9B2C" />

            <!-- Status badge -->
            <TextView
                android:id="@+id/tvOrderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                tools:text="HOÀN THÀNH"
                tools:background="@drawable/bg_order_status_completed" />

        </LinearLayout>

        <!-- ── Course rows container ─────────────────────── -->
        <!--  OrderAdapter inflates item_order_course.xml rows here -->
        <LinearLayout
            android:id="@+id/llOrderCourses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- "See more N items" link (hidden when courses ≤ 2) -->
        <TextView
            android:id="@+id/tvOrderMoreItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Xem thêm 1 sản phẩm"
            tools:visibility="visible" />

        <!-- ── Divider ─────────────────────────────────── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="@color/divider" />

        <!-- ── Total row ───────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/order_total_label"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvOrderTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/order_total_amount_text"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="599.000 đ" />

        </LinearLayout>

        <!-- ── Action buttons – compact, right-aligned ────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end|center_vertical">

            <!-- Left action (outline style) -->
            <TextView
                android:id="@+id/btnOrderActionLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_btn_outline"
                android:textColor="@color/text_secondary"
                tools:text="Đánh giá" />

            <!-- Right action (primary / filled) -->
            <TextView
                android:id="@+id/btnOrderActionRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_gradient_button"
                android:textColor="@color/white"
                tools:text="Vào học ngay" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
