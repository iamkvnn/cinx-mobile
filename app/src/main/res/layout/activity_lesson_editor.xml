<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarLessonEditor"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:title="Edit Lesson Content"
        app:titleTextColor="@color/white"
        app:navigationIcon="@drawable/ic_back"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title Indicator -->
            <TextView
                android:id="@+id/tvEditorTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lesson Name"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_marginBottom="16dp"/>

            <!-- Article Editor -->
            <LinearLayout
                android:id="@+id/llArticleEditor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Noi dung bai viet:"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/etArticleContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="8"
                    android:gravity="top|start"
                    android:hint="Nhap noi dung article..."
                    android:background="@drawable/bg_border_rounded"
                    android:padding="12dp"/>
            </LinearLayout>

            <!-- Video Editor -->
            <LinearLayout
                android:id="@+id/llVideoEditor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvCurrentVideo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Video hien tai:"
                    android:textStyle="italic"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btnPickVideo"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chon video tu may..."/>
                
                <ProgressBar
                    android:id="@+id/pbVideoUpload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"/>
                    
                <TextView
                    android:id="@+id/tvUploadStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:text="Dang tai len..."
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Quiz Editor -->
            <LinearLayout
                android:id="@+id/llQuizEditor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thoi gian lam bai (phut):"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/etQuizDuration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:hint="Vi du: 30"
                    android:background="@drawable/bg_border_rounded"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="So lan nop bai:"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/etQuizMaxAttempt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:hint="Vi du: 3"
                    android:background="@drawable/bg_border_rounded"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp"/>

                <CheckBox
                    android:id="@+id/cbIsReviewAllowed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cho phep xem lai bai thi"/>

            </LinearLayout>
            
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnSaveContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:backgroundTint="@color/primary"
        android:text="Luu noi dung"/>

</LinearLayout>
