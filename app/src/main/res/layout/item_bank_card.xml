<?xml version="1.0" encoding="utf-8"?>
<!-- Virtual bank/credit card – used inside the ViewPager2 card stack -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="4dp">

    <LinearLayout
        android:id="@+id/cardRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_bank_card"
        android:padding="22dp"
        android:elevation="4dp">

        <!-- Row 1: chip + network logo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <!-- Chip icon -->
            <View
                android:layout_width="40dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_grade_excellent"
                android:backgroundTint="#D4A017" />

            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

            <!-- Network logo text (VISA / MC) -->
            <TextView
                android:id="@+id/tvNetwork"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:letterSpacing="0.05"
                tools:text="VISA" />
        </LinearLayout>

        <!-- Row 2: masked card number -->
        <TextView
            android:id="@+id/tvCardNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="#CCFFFFFF"
            android:letterSpacing="0.1"
            android:fontFamily="monospace"
            android:layout_marginBottom="20dp"
            tools:text="•••• •••• •••• 4281" />

        <!-- Row 3: cardholder + expiry -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pm_card_holder_label"
                    android:textSize="9sp"
                    android:textColor="#99FFFFFF"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvCardholderName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    tools:text="NGUYEN HOANG MINH" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pm_card_expiry_label"
                    android:textSize="9sp"
                    android:textColor="#99FFFFFF"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvExpiry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    tools:text="12/28" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
