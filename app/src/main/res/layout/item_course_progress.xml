<?xml version="1.0" encoding="utf-8"?>
<!--
  item_course_progress.xml
  ────────────────────────
  Card for a course the user is currently taking.
  Sections:
    1. Top row   – thumbnail · title + instructor / category · more-menu icon
    2. Next lesson box – "TIẾP THEO" badge · last-accessed time · lesson name · progress bar
    3. CTA button – "Tiếp tục học" (dark, full-width)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <!-- ── Top row ─────────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <!-- Course thumbnail -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgCourse"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:background="#E2E8F0"
            app:shapeAppearanceOverlay="@style/RoundedImageView" />

        <!-- Title + instructor column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="4dp"
            android:gravity="top">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.25"
                android:layout_marginBottom="5dp" />

            <TextView
                android:id="@+id/tvInstructor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- More-options button -->
        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@android:color/transparent"
            android:padding="4dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/text_placeholder"
            android:contentDescription="Tuỳ chọn" />

    </LinearLayout>

    <!-- ── Next lesson box ───────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_next_lesson_box"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_marginTop="12dp">

        <!-- Badge + last-accessed row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <!-- "TIẾP THEO" badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TIẾP THEO"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:background="@drawable/bg_ml_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Clock icon + last-accessed time -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/text_placeholder"
                    android:layout_marginEnd="3dp" />

                <TextView
                    android:id="@+id/tvLastAccessed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:textColor="@color/text_placeholder" />

            </LinearLayout>
        </LinearLayout>

        <!-- Next lesson name -->
        <TextView
            android:id="@+id/tvNextLesson"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="10dp" />

        <!-- Progress bar + percentage -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:max="100"
                android:progressDrawable="@drawable/bg_progress_bar_ml" />

            <TextView
                android:id="@+id/tvProgress"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginStart="8dp"
                android:gravity="end" />

        </LinearLayout>
    </LinearLayout>

    <!-- ── "Tiếp tục học" CTA ────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_btn_dark_full"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tiếp tục học"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_play_circle"
            app:tint="#FFFFFF" />

    </LinearLayout>

</LinearLayout>
