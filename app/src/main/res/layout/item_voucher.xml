<?xml version="1.0" encoding="utf-8"?>
<!-- Single voucher row inside the picker bottom sheet -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_voucher_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Voucher icon -->
    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_icon_purple"
        android:padding="8dp"
        android:src="@drawable/ic_zap"
        app:tint="@color/primary"
        android:contentDescription="@null" />

    <!-- Texts -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvVoucherTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Giảm 20% cho thành viên mới" />

        <TextView
            android:id="@+id/tvVoucherDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="Áp dụng cho mọi khóa học" />

        <TextView
            android:id="@+id/tvVoucherCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="MÃ: EDUFUTURE" />

    </LinearLayout>

    <!-- Radio button -->
    <RadioButton
        android:id="@+id/rbVoucher"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:buttonTint="@color/primary"
        android:clickable="false"
        android:focusable="false" />

</LinearLayout>
