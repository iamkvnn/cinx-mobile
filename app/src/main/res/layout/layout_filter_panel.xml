<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <TextView
        android:id="@+id/filterTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:text="Bộ lọc tìm kiếm"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintTop_toBottomOf="@id/filterTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Sort Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Sắp xếp theo"
                android:textColor="#64748B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgSort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp">

                <RadioButton
                    android:id="@+id/rbSortPopular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Phổ biến nhất"
                    android:paddingStart="8dp"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/rbSortNewest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mới nhất"
                    android:paddingStart="8dp"
                    android:textSize="15sp" />

                <RadioButton
                    android:id="@+id/rbSortPriceAsc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Giá thấp đến cao"
                    android:paddingStart="8dp"
                    android:textSize="15sp" />

                 <RadioButton
                    android:id="@+id/rbSortPriceDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Giá cao đến thấp"
                    android:paddingStart="8dp"
                    android:textSize="15sp" />
            </RadioGroup>

            <!-- Category Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Danh mục"
                android:textColor="#64748B"
                android:textSize="14sp"
                android:textStyle="bold" />

             <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="false">
             </com.google.android.material.chip.ChipGroup>

             <View android:layout_width="match_parent" android:layout_height="24dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Buttons -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="#FFFFFFFF"
        android:elevation="8dp">

        <Button
            android:id="@+id/btnClear"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Xóa lọc"
            android:textColor="#64748B" />

        <Button
            android:id="@+id/btnApply"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:backgroundTint="@color/primary"
            android:text="Cập nhật"
            app:cornerRadius="16dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
