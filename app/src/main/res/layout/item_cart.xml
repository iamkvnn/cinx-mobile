<?xml version="1.0" encoding="utf-8"?>
<!--
  Cart item row.
  The red "delete" background is drawn on the canvas by the ItemTouchHelper
  in CartActivity, so no extra View is needed here for it.
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Checkbox using custom icons -->
        <CheckBox
            android:id="@+id/cbSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:button="@drawable/checkbox_selector"
            android:buttonTint="@color/primary"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:minWidth="48dp"
            android:minHeight="48dp" />

        <!-- Course thumbnail -->
        <ImageView
            android:id="@+id/ivThumbnail"
            android:layout_width="80dp"
            android:layout_height="70dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@string/cart_course_image"
            android:scaleType="centerCrop"
            tools:src="@drawable/bg_glass_card"
            app:shapeAppearanceOverlay="@style/RoundedImageView" />

        <!-- Text info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCartTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="UI/UX Design Masterclass: Từ Cơ Bản Đến Nâng Cao" />

            <TextView
                android:id="@+id/tvCartInstructor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="Bởi Hà Linh" />

            <!-- Prices -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvOldPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:textColor="@color/text_placeholder"
                    android:textSize="12sp"
                    tools:text="1.200.000 đ" />

                <TextView
                    android:id="@+id/tvSalePrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="599.000 đ" />

            </LinearLayout>
        </LinearLayout>

        <!-- Inline delete button (tapping, vs swipe) -->
        <ImageButton
            android:id="@+id/btnDeleteItem"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_icon_gray"
            android:contentDescription="@string/cart_delete_item"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
