<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/glass_card_bg"
    android:padding="12dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginBottom="12dp"
    android:alpha="0.9">

    <FrameLayout
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:background="@drawable/border_panel"
        android:clipToOutline="true"
        android:outlineProvider="background">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgCourse"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="#E2E8F0"
            app:shapeAppearanceOverlay="@style/RoundedImageView" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#337C3AED" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_star"
            app:tint="@android:color/white" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginHorizontal="12dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tvGrade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#16A34A"
            android:background="@drawable/bg_grade_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnCertificate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chứng chỉ"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:background="@drawable/glass_card_bg"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp" />

</LinearLayout>
